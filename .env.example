# Copy to .env (gitignored). Uses Vertex AI via your gcloud login: no API key.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=hormuz-pulse-agent
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
MODEL_ARMOR_LOCATION=
MODEL_ARMOR_INPUT_TEMPLATE=hormuz-input
MODEL_ARMOR_OUTPUT_TEMPLATE=hormuz-output
# MODEL_ARMOR_FAIL_OPEN=true
